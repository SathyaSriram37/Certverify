# Database Configuration (Supabase PostgreSQL)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_password@db.your_supabase_project.supabase.co:5432/postgres
# Synchronous DB URL for Celery / Alembic migrations if needed:
DATABASE_SYNC_URL=postgresql://postgres:your_supabase_password@db.your_supabase_project.supabase.co:5432/postgres

# Supabase API Credentials
SUPABASE_URL=https://your_supabase_project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis & Celery
REDIS_URL=redis://:strongredispassword123@redis:6379/0
CELERY_BROKER_URL=redis://:strongredispassword123@redis:6379/1
CELERY_RESULT_BACKEND=redis://:strongredispassword123@redis:6379/2
REDIS_PASSWORD=strongredispassword123

# Security & JWT
SECRET_KEY=change-this-to-a-32-char-minimum-secret-production-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Local Postgres Fallback (for offline / docker-compose testing)
POSTGRES_DB=certverify
POSTGRES_USER=certverify
POSTGRES_PASSWORD=strongdbpassword123

# Server & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:80"]
MAX_FILE_SIZE_MB=10
VITE_API_URL=http://localhost:8000

